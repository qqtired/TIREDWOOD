{
  "name": "game-opus",
  "version": "0.1.0",
  "private": true,
  "description": "TIREDWOOD (рабочее имя Game Opus) — браузерная игра для своей компании: набережная, пейнтбол, картинг, дурак",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/main.ts --dev",
    "build": "vite build",
    "start": "node server/main.ts",
    "play": "vite build && node server/main.ts",
    "check": "tsc --noEmit -p .",
    "test": "node --test \"test/*.test.ts\"",
    "fitting:dev": "vite --config tools/fitting-room/vite.config.ts",
    "fitting:build": "vite build --config tools/fitting-room/vite.config.ts",
    "fitting:preview": "vite preview --config tools/fitting-room/vite.config.ts",
    "bench:dev": "vite --config tools/render-bench/vite.config.ts",
    "bench:check": "tsc --noEmit -p tools/render-bench/tsconfig.json",
    "bench:build": "vite build --config tools/render-bench/vite.config.ts",
    "bench:preview": "vite preview --config tools/render-bench/vite.config.ts"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/alegreya-sc": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
